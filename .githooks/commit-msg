#!/bin/sh
# Rejects commit messages that are not Conventional Commits.
#
# release.yml (.github/scripts/next-version.sh) reads every subject on main to
# pick the version bump; one it can't parse counts as a patch. This hook is the
# local half of the gate; ci.yml's commit-lint job is the half --no-verify
# cannot bypass.
#
# POSIX sh, no bashisms, to match scripts/install.sh's portability discipline.

set -eu

msg_file="$1"
subject=$(head -n1 "$msg_file")

# Merge commits and fixups/squash markers aren't release input.
case "$subject" in
  "Merge "*|"fixup! "*|"squash! "*|"Revert "*)
    exit 0
    ;;
esac

# type(scope)!: subject  — scope and ! are optional.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  cat >&2 <<EOF
[commit-msg] rejected: "$subject"

Conventional Commits required — the release workflow derives the version bump
from this subject line (see CONTRIBUTING.md#commit-messages).

  type(scope): subject
  types: feat fix docs style refactor perf test build ci chore revert

Examples:
  feat(daemon): add timeline pagination
  fix(store): stop truncating names above 255 bytes

Bypass (rare, e.g. a merge/fixup you're about to squash): git commit --no-verify
EOF
  exit 1
fi
